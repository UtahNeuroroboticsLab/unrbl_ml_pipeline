// Shared by both training examples. Python overrides follow this file; CLI flags win.
// Optional: add normalize between select_features and window in preprocessing_steps.
// Loss choices: mse, mse_pinn, mse_jacobian, mse_pinn_jacobian.
{
  "model_name": "mamba_decoder",
  "preprocessing_steps": [
    "load_kdf",
    "quality_filter",
    "split_by_detected_trial_deadzone",
    "align_lag",
    "align_trials", // Comment out this entry to disable per-trial alignment.
    "select_features",
    "window"
  ],
  // Keep padding identical when comparing global-only and per-trial alignment.
  "split": {"trial_detection": {"pre_cue_samples": 40}},
  // Initial sample-based detector settings; inspect training diagnostics before tuning.
  "trial_alignment": {
    "feature_indices": "emg",
    "max_residual_lag_samples": 10,
    "baseline_samples": 10,
    "threshold_multiplier": 3.0,
    "min_active_samples": 3
  },
  "data": {
    // Opt in to evenly spaced row-order time for unusable clocks; preserve usable clocks.
    "allow_missing_timestamps": true, // I enabled this
    // Null estimates the interval from matched usable clocks. Override in timestamp units.
    "sample_interval": null,
    "base_dir": "data/training_data",
    "kdf_format": "cob",
    "kdf_glob": "**/*.kdf",
    "beta_threshold": 0.2,
    "num_raw_features": 496,
    "kinematic_column_indices": [
      0,
      1,
      2,
      3,
      4,
      5
    ],
    "dof_names": [
      "thumb",
      "index",
      "mrp",
      "thumb_int",
      "wrist_fe",
      "wrist_rot"
    ]
  },
  "output_dir": "outputs",
  "state_mode": "carry",
  "loss": {
    "type": "mse_pinn_jacobian", // "mse" //
    "warmup_epochs": 20
  },
  "model": {
    "window_size": 10,
    "prediction_lag_samples": 1
  },
  "alignment": {
    "lag_min": -20,
    "lag_max": 20
  },
  "feature_selection": {
    "count": 48,
    "corr_threshold": 0.3,
    "candidates": "emg"
  },
  "streams": 4,
  "tbptt_steps": 16
}
